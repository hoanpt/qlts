generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  password     String
  fullName     String
  role         String    @default("DEPARTMENT") // ADMIN, DEPARTMENT
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Department {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  location    String   @default("Cơ sở 1") // "Cơ sở 1" or "Cơ sở 2"
  description String?
  users       User[]
  assets      Asset[]
  transfersFrom AssetTransfer[] @relation("FromDepartment")
  transfersTo   AssetTransfer[] @relation("ToDepartment")
  maintenanceRequests MaintenanceRequest[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssetCategory {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  assets      Asset[]
}

model Asset {
  id                Int       @id @default(autoincrement())
  assetCode         String    @unique
  name              String
  categoryId        Int
  category          AssetCategory @relation(fields: [categoryId], references: [id])
  departmentId      Int
  department        Department @relation(fields: [departmentId], references: [id])
  location          String?   // Cơ sở 1 or Cơ sở 2
  locationDetail    String?   // Phòng cụ thể
  assignedTo        String?   // Người sử dụng
  yearInUse         Int?      // Năm đưa vào sử dụng
  originalPrice     Float?    // Nguyên giá
  currentValue      Float?    // Giá trị còn lại
  depreciationRate  Float?    // Tỷ lệ hao mòn %
  manufacturer      String?   // Hãng sản xuất
  countryOfOrigin   String?   // Nước sản xuất
  specifications    String?   // Cấu hình / thông số kỹ thuật
  status            String    @default("DANG_SU_DUNG") // DANG_SU_DUNG, HONG, KHONG_SU_DUNG, CHO_THANH_LY, DA_THANH_LY, BAO_TRI, CHO_PHAN_BO
  managingUnit      String?   @default("TCHC") // TCHC, DUOC, CNTT
  floor             String?   // Tầng Hầm, Tầng 1 .. Tầng 7
  buildingAsset     Int?      @default(0) // 1 if building infrastructure asset, 0 otherwise
  bookQuantity      Int       @default(1)
  actualQuantity    Int       @default(1)
  quantityDifference Int      @default(0)
  source            String?   // Nguồn gốc: Ngân sách, Viện trợ, Mua mới...
  fundingSource     String?   // Nguồn kinh phí (Ngân sách, Quỹ PTHĐSN, Viện trợ...)
  decisionNumber    String?   // Quyết định mua sắm / trang cấp / phê duyệt
  note              String?
  qrCode            String?   @unique
  transfers         AssetTransfer[]
  maintenanceRequests MaintenanceRequest[]
  inventoryRecords  InventoryRecord[]
  disposals         Disposal[]
  depreciations     Depreciation[]
  calibrations      CalibrationRecord[]
  plannedMaintenances PlannedMaintenance[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model InventoryCommitteeMember {
  id           Int       @id @default(autoincrement())
  fullName     String
  position     String
  role         String
  departmentId Int?
  scope        String?   @default("ALL")
  isActive     Int?      @default(1)
  displayOrder Int?      @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AssetTransfer {
  id               Int       @id @default(autoincrement())
  assetId          Int
  asset            Asset     @relation(fields: [assetId], references: [id])
  fromDepartmentId Int
  fromDepartment   Department @relation("FromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartmentId   Int
  toDepartment     Department @relation("ToDepartment", fields: [toDepartmentId], references: [id])
  transferDate     DateTime  @default(now())
  reason           String?
  approvedBy       String?
  note             String?
  status           String    @default("PENDING") // PENDING, APPROVED, REJECTED, COMPLETED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model MaintenanceRequest {
  id               Int       @id @default(autoincrement())
  assetId          Int
  asset            Asset     @relation(fields: [assetId], references: [id])
  requestedBy      String    // Tên người đề nghị
  contactPhone     String?   // Số điện thoại liên hệ
  departmentId     Int
  department       Department @relation(fields: [departmentId], references: [id])
  managingUnit     String?   // DUOC, CNTT, TCHC
  locationDetail   String?   // Vị trí phòng máy cụ thể
  issueDescription String
  priority         String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status           String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, REJECTED
  repairCost       Float?
  repairVendor     String?
  repairNote       String?
  technicianName   String?   // Tên cán bộ kỹ thuật tiếp nhận / xử lý
  maintenanceType  String?   @default("SUA_CHUA") // SUA_CHUA, BAO_TRI
  servicePackage   String?   // Gói bảo trì / dịch vụ
  replacementParts String?   // Linh kiện thay thế
  acceptanceMembers String?  // Người nghiệm thu
  fundingSource    String?   // Nguồn kinh phí (Thu sự nghiệp, Quỹ PTHĐSN, Ngân sách cấp...)
  decisionNumber   String?   // Quyết định số 12/QĐ-TTKSBT, 34/QĐ-TTKSBT...
  deviceStatusAfter String?  @default("Tốt")
  proposalDate     DateTime? // Ngày trình phê duyệt
  approvalDate     DateTime?
  requestDate      DateTime  @default(now())
  completedDate    DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model InventorySession {
  id          Int       @id @default(autoincrement())
  name        String
  decisionNumber String? // Quyết định thành lập Hội đồng kiểm kê
  fundingSource  String?
  startDate   DateTime  @default(now())
  endDate     DateTime?
  status      String    @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED
  createdBy   String?
  records     InventoryRecord[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InventoryRecord {
  id             Int       @id @default(autoincrement())
  sessionId      Int
  session        InventorySession @relation(fields: [sessionId], references: [id])
  assetId        Int
  asset          Asset     @relation(fields: [assetId], references: [id])
  bookQuantity   Int
  actualQuantity Int
  difference     Int
  condition      String?   // Tình trạng thực tế
  note           String?
  checkedBy      String?
  checkedDate    DateTime  @default(now())
}

model Disposal {
  id                  Int       @id @default(autoincrement())
  assetId             Int
  asset               Asset     @relation(fields: [assetId], references: [id])
  proposedDate        DateTime  @default(now())
  disposalDate        DateTime?
  reason              String
  proposedBy          String?
  approvedBy          String?
  approvalDate        DateTime?
  disposalPrice       Float?
  status              String    @default("PROPOSED") // PROPOSED, APPROVED, COMPLETED, REJECTED
  decisionNumber      String?   // Quyết định thanh lý / QĐ thành lập HĐ thanh lý
  fundingSource       String?   // Nộp NSNN / Quỹ PTHĐSN
  campaignName        String?   // Tên đợt thanh lý
  technicalAssessment String?   // Thẩm định tình trạng kỹ thuật
  technicalInspector  String?   // Cán bộ kỹ thuật kiểm tra (Ds. Tính, Cn. Hoàn, Ô. Liên)
  disposalMethod      String?   // Bán phế liệu, Tiêu hủy, Bán đấu giá
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model DisposalCampaign {
  id           Int       @id @default(autoincrement())
  title        String
  campaignCode String?
  startDate    DateTime  @default(now())
  endDate      DateTime?
  status       String    @default("OPEN")
  description  String?
  issuedBy     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Depreciation {
  id                      Int       @id @default(autoincrement())
  assetId                 Int
  asset                   Asset     @relation(fields: [assetId], references: [id])
  year                    Int
  depreciationAmount      Float
  accumulatedDepreciation Float
  remainingValue          Float
  calculatedDate          DateTime  @default(now())
}

model CalibrationRecord {
  id                  Int       @id @default(autoincrement())
  assetId             Int
  asset               Asset     @relation(fields: [assetId], references: [id])
  calibrationDate     DateTime
  nextCalibrationDate DateTime?
  performedBy         String?
  vendor              String?
  result              String    @default("PASS") // PASS, FAIL, CONDITIONAL
  certificateNumber   String?
  note                String?
  serviceType         String?   @default("HIEU_CHUAN") // HIEU_CHUAN, KIEM_DINH, THU_NGHIEM, KIEM_XA
  servicePackage      String?   // Gói dịch vụ ISO 17025...
  cost                Float?    @default(0)
  decisionNumber      String?   // Quyết định số 34/QĐ-TTKSBT...
  acceptanceMembers   String?   // Người nghiệm thu (Ds. Tính, Ds. Lộc, Cn. Hải, Cn. Sơn...)
  fundingSource       String?   // Thu sự nghiệp, Quỹ PTHĐSN...
  deviceStatusAfter   String?   @default("Tốt")
  departmentLocation  String?   // Bộ phận sử dụng (HIV-CS1, HL-CS2...)
  proposalDate        DateTime?
  approvalDate        DateTime?
  createdAt           DateTime  @default(now())
}

model PlannedMaintenance {
  id                  Int       @id @default(autoincrement())
  assetId             Int
  asset               Asset     @relation(fields: [assetId], references: [id])
  maintenanceDate     DateTime  @default(now())
  nextMaintenanceDate DateTime?
  cycleMonths         Int?      @default(6) // Chu kỳ: 1, 3, 6, 12 tháng
  performedBy         String?   // Cán bộ thực hiện / phụ trách
  vendor              String?   // Đơn vị bảo trì
  planContent         String?   // Nội dung bảo trì theo kế hoạch
  result              String    @default("PASS") // PASS (Đạt yêu cầu), FAIL (Không đạt), PENDING (Đang thực hiện), NEEDS_REPAIR (Cần sửa chữa thêm)
  cost                Float?    @default(0)
  decisionNumber      String?   // Kế hoạch số / QĐ số
  acceptanceMembers   String?   // Người nghiệm thu
  fundingSource       String?   // Nguồn kinh phí
  deviceStatusAfter   String?   @default("Hoạt động tốt")
  note                String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
